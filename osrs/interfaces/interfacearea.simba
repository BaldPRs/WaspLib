(*
# InterfaceArea
Interface area is the area where {ref}`MainScreen` interfaces can occupy.
*)
{$DEFINE WL_INTERFACE_AREA_INCLUDED}
{$INCLUDE_ONCE WaspLib/osrs.simba}

type
(*
(ERSInterfaceType)=
## ERSInterfaceType enum
```pascal
ERSInterfaceType = enum(CLASSIC, PAPER, ANY);
```
Enum representing the types of {ref}`MainScreen` interfaces.
*)
  ERSInterfaceType = enum(CLASSIC, PAPER, ANY);

(*
(TRSInterfaceArea)=
## TRSInterfaceArea type
Type responsible to handle thefor handling general {ref}`MainScreen` interfaces.
*)
  TRSInterfaceArea = type TRSInterface;

procedure TRSInterfaceArea.SetupInterface();
begin
  Self.Bounds.Y1 := MainScreen.Bounds.Y1;
  Self.Bounds.X1 := MainScreen.Bounds.X1;

  case RSClient.Mode of
    ERSMode.FIXED:
    begin
      Self.Bounds.X2 := MainScreen.Bounds.X2;
      Self.Bounds.Y2 := MainScreen.Bounds.Y2;
    end;

    ERSMode.RESIZABLE:
    begin
      Self.Bounds.X2 := GameTabs.Bounds.X1 - 10;
      Self.Bounds.Y2 := Chat.Bounds.Y1-1;
    end;

    ERSMode.MODERN_COMPACT, ERSMode.MODERN_WIDE:
    begin
      Self.Bounds.X2 := GameTab.Bounds.X1 - 22;
      Self.Bounds.Y2 := Chat.Bounds.Y1-1;
    end;
  end;

  Self.Width  := Self.Bounds.Width;
  Self.Height := Self.Bounds.Height;
  Self.Center := Self.Bounds.Center;

  Self.TopLeft     := Self.Bounds.TopLeft;
  Self.TopRight    := Self.Bounds.TopRight;
  Self.BottomRight := Self.Bounds.BottomRight;
  Self.BottomLeft  := Self.Bounds.BottomLeft;

  Self.Quad := TQuad.CreateFromBox(Self.Bounds);
end;

(*
## MSInterface.IsOpen
```pascal
function TRSInterfaceArea.IsOpen(typ: ERSInterfaceType = ERSInterfaceType.ANY): Boolean;
```
Returns True/False if any interface is found open.
*)
function TRSInterfaceArea.IsOpen(typ: ERSInterfaceType = ERSInterfaceType.ANY): Boolean;
const
  CLASSIC: TColorTolerance = [$323E47, 0.75, EColorSpace.HSV, [0.778, 1.112, 1.112]];
  PAPER:   TColorTolerance = [$88AABD, 0.4,  EColorSpace.HSV, [1.366, 1.437, 0.199]];
begin
  case typ of
    ERSInterfaceType.CLASSIC: Result := Target.HasColor(CLASSIC, 10000, Self.Bounds);
    ERSInterfaceType.PAPER: Result := Target.HasColor(PAPER, 10000, Self.Bounds);
    else Result := Self.IsOpen(ERSInterfaceType.CLASSIC) or
                   Self.IsOpen(ERSInterfaceType.PAPER);
  end;
end;

(*
## MSInterface.WaitOpen
```pascal
function TRSInterfaceArea.WaitOpen(
  typ: ERSInterfaceType = ERSInterfaceType.ANY;
  time: Integer = TICK;
  interval: Integer = -1
): Boolean;
```
Returns True/False if any interface is found open within `time` milliseconds.
*)
function TRSInterfaceArea.WaitOpen(
  typ: ERSInterfaceType = ERSInterfaceType.ANY;
  time: Integer = TICK;
  interval: Integer = -1
): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(typ), interval, time);
end;


(*
## MSInterface.GetCloseButton
function TRSInterfaceArea.GetCloseButton(): TBox;
```
Returns a TBox of the close button.

Example:
```pascal
{$I WaspLib/osrs.simba}
begin
  ShowOnTarget(MSInterface.GetCloseButton());
end.
```
*)
function TRSInterfaceArea.GetCloseButton(): TBox;
var
  tpa: TPointArray;
  atpa: T2DPointArray;
  b: TBox;
  circ, dist, best: Double;
begin
  b.X1 := Self.Bounds.X2-Self.Bounds.Width div 3;
  b.Y1 := Self.Bounds.Y1;
  b.X2 := Self.Bounds.X2;
  b.Y2 := Self.Bounds.Y1 + Self.Bounds.Height div 3;

  tpa := Target.FindColor(TRSInterface.BORDER, 0, b);

  if tpa.IsEmpty then
    Exit;

  atpa := tpa.Cluster(3);

  best := $FFFFFFFF;

  for tpa in atpa do
  begin
    if Length(tpa) < 50 then
      Continue;

    b := tpa.Bounds();

    case b.Height of 21,23:; else Continue; end;
    case b.Width of 21,24:; else Continue; end;

    circ := tpa.Circularity();

    if InRange(circ, 0.443, 0.445) or InRange(circ, 0.471, 0.473) then
    begin
      dist := b.Center.DistanceTo(Self.TopRight);
      if dist < best then
      begin
        Result := b;
        best := dist;
      end;
    end;
  end;
end;


(*
## MSInterface.Close
function TRSInterfaceArea.Close(escape: Boolean): Boolean;
function TRSInterfaceArea.Close(escapeProbability: Single = -1): Boolean; overload;
```
Attempts to close any interface currently open, depending on `escape` or
`escapeProbability the function will either click the button or press escape key.

Example:
```pascal
WriteLn MSInterface.Close();
```
*)
function TRSInterfaceArea.Close(escape: Boolean): Boolean;
var
  b: TBox;
begin
  if not Self.IsOpen() then
    Exit(True);

  case escape of
    False:
    begin
      b := Self.GetCloseButton();
      if b = Default(TBox) then
        Exit;
      Mouse.Click(b, EMouseButton.LEFT);
    end;
    True:  Keyboard.KeyPress(EKeyCode.ESCAPE);
  end;

  Result := SleepUntil(not Self.IsOpen(), 50, 600);
end;

function TRSInterfaceArea.Close(escapeProbability: Single = -1): Boolean; overload;
begin
  if escapeProbability = -1 then
    escapeProbability := Biometrics.RandomDouble(0.5);
  Result := Self.Close(RandomBoolean(escapeProbability));
end;


function TRSInterfaceArea.CreateBounds(offset: TBox; width, height: Integer = 0): TBox;
var
  center, half, halfSize: Double;
begin
  offset.X1 += Self.Bounds.X1;
  offset.Y1 += Self.Bounds.Y1;
  offset.X2 += Self.Bounds.X2;
  offset.Y2 += Self.Bounds.Y2;

  if width > 0 then
  begin
    half := (offset.X2 - offset.X1) / 2;
    center := offset.X1 + half;
    halfSize := (width - 1) / 2;

    Result.X1 := Floor(Max(center - half, center - halfSize));
    Result.X2 := Floor(Min(center + half, center + halfSize));
  end
  else
  begin
    Result.X1 := offset.X1;
    Result.X2 := offset.X2;
  end;

  if height > 0 then
  begin
    half := (offset.Y2 - offset.Y1) / 2;
    center := offset.Y1 + half;
    halfSize := (height - 1) / 2;

    Result.Y1 := Floor(Max(center - half, center - halfSize));
    Result.Y2 := Floor(Min(center + half, center + halfSize));
  end
  else
  begin
    Result.Y1 := offset.Y1;
    Result.Y2 := offset.Y2;
  end;
end;

var
(*
## MSInterface variable
Global {ref}`TRSInterfaceArea` variable.
*)
  MSInterface: TRSInterfaceArea;
