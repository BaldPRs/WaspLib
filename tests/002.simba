(*
# Login Tests
Tests the integrity of several login methods.
*)
{$DEFINE WL_TEST}
{$I WaspLib/main.simba}
{$ASSERTIONS ON}

const
  PATH: String = {$MACRO DIR} + 'imgs' + PATH_SEP;
  MODES: TStringArray = ['fixed', 'resizable_classic'];
  FILENAME: String := PATH_SEP + PathExtractNameWithoutExt(SCRIPT_FILE);
var
  mode: String;
  img: TImage;
begin
  for mode in modes do
  begin
    img := new TImage(PATH + mode + FILENAME + '-0.png');
    Target.SetImage(img);

    WaspLibSetup();

    Assert(Client.IsLoggedIn() = False);
    Assert(Login.GetMessage() = ELoginMessage.WELCOME);
    Assert(Login.FindButton(ELoginButton.EXISTING_USER));
    Assert(Login.GetMode() = ELoginMode.LEGACY);
    Assert(LoginWorldSwitcher.IsOpen() = False);
    Assert(LoginWorldSwitcher.GetCurrent() = 333);
    Assert(Lobby.IsOpen() = False);

    img := new TImage(PATH + mode + FILENAME + '-1.png');
    Target.SetImage(img);

    WaspLibSetup();

    Assert(Client.IsLoggedIn() = False);
    Assert(Login.GetMessage() = ELoginMessage.ENTER_CREDENTIALS);
    Assert(Login.ClearInput(ELoginInput.USERNAME));
    Assert(Login.ClearInput(ELoginInput.PASSWORD));
    Assert(Login.FindButton(ELoginButton.LOGIN));

    img := new TImage(PATH + mode + FILENAME + '-2.png');
    Target.SetImage(img);

    WaspLibSetup();

    Assert(Client.IsLoggedIn() = False);
    Assert(Login.GetMessage() = ELoginMessage.CONNECTING);
    Assert(Login.InputIsFilled(ELoginInput.USERNAME));
    Assert(Login.InputIsFilled(ELoginInput.PASSWORD));

    img := new TImage(PATH + mode + FILENAME + '-3.png');
    Target.SetImage(img);

    WaspLibSetup();

    Assert(Client.IsLoggedIn() = False);
    Assert(Login.GetMessage() = ELoginMessage.INCORRECT);
    Assert(Login.FindButton(ELoginButton.RETRY));

    img := new TImage(PATH + mode + FILENAME + '-4.png');
    Target.SetImage(img);

    WaspLibSetup();

    Assert(Client.IsLoggedIn() = False);
    Assert(Lobby.IsOpen());

    img := new TImage(PATH + mode + FILENAME + '-5.png');
    Target.SetImage(img);

    WaspLibSetup();

    Assert(Client.IsLoggedIn() = False);
    Assert(LoginWorldSwitcher.IsOpen());
    Assert(LoginWorldSwitcher.Read(0) = 301);
    Assert(LoginWorldSwitcher.Read(10) = 375);
    Assert(LoginWorldSwitcher.Read(40) = 440);
    Assert(Lobby.IsOpen() = False);
  end;
end;
